# 复制这个文件为 .dev.vars（本地开发用），或者用 wrangler secret put 设置到线上。
#
#   cp .dev.vars.example .dev.vars
#
# .dev.vars 已被 .gitignore 忽略，不会被提交。

# 主账号 owner 的首次初始化密码。留空不会关闭认证；初始化后在设置中修改密码。
APP_PASSWORD=change-me-please

# 会话签名密钥，随便一串长随机字符即可。生成方法：
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=replace-with-a-long-random-string

# 每个账号的文档存储容量上限（字节）。8 GiB = 8589934592
STORAGE_QUOTA_BYTES=8589934592

# 会话有效期（天）
SESSION_DAYS=30
